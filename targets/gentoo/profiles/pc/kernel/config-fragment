CONFIG_VFIO=m
CONFIG_VFIO_PCI=m
CONFIG_TUN=m
CONFIG_BRIDGE=m
CONFIG_VETH=m
CONFIG_MACVLAN=m
CONFIG_MACVTAP=m
CONFIG_VLAN_8021Q=m
CONFIG_DUMMY=m
CONFIG_HUGETLBFS=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# ---- containers ----
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUP_NS=y
