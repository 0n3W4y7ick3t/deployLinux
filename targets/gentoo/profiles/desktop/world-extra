# PC-only atoms, merged on top of the base world by scripts/20-world.sh.

# kernel: custom build from sys-kernel/gentoo-sources (in the base world
# file) — no dist-kernel here, it ships ext4/xfs as modules and would need
# an initramfs. See kernel/README.md.

# hyprland overview plugin; re-emerge after every hyprland bump
hyprland-plugin/hyprexpo-sandwichfarm

# gpu
x11-drivers/nvidia-drivers
media-libs/nvidia-vaapi-driver

# containers extras / k8s
app-containers/nvidia-container-toolkit
sys-cluster/minikube
sys-cluster/kubectl
sys-cluster/k9scli

# virtualization
app-emulation/qemu
app-emulation/libvirt
app-emulation/virt-manager
app-emulation/virt-viewer

# net analysis
net-analyzer/nmap
net-analyzer/wireshark

# database clients (2026-08-13). dbeaver-bin is the GUI; nothing on this box
# runs a database itself, they live in containers and on remote hosts. The
# CLI client is not portage's — mysql and mysqldump come from
# conda:mysql-client via mise, pinned in rice's .config/mise/config.toml.
# shellcheck-bin is wanted before every commit here, per CONVENTIONS.
#
# Language toolchains are deliberately absent from this file too; the base
# world file explains where they live instead.
dev-util/shellcheck-bin
dev-db/dbeaver-bin

# terminal mail (2026-08-20): pulls neomutt, isync, msmtp, pass, notmuch.
# msmtp[mta] replaces nullmailer as the virtual/mta provider. The rice layer
# already binds mw -Y to $mod+F8; accounts live in pass, not in this repo.
# paperkey archives the gpg secret key to printable text.
mail-client/mutt-wizard
app-crypt/paperkey

# mtp mounting for garmin watch / android phones (2026-08-20).
# aft-mtp-mount is the FUSE mount; libmtp is wanted for its uaccess udev
# rules (elogind grants the seat user access) and mtp-detect.
sys-fs/android-file-transfer-linux
media-libs/libmtp

# desktop apps that were installed by hand before this file caught up
# (2026-09-16): an editor, a git TUI and two chat clients. The proprietary
# ones need no package.license entry — make.conf.shared sets ACCEPT_LICENSE="*".
app-editors/vscode
dev-vcs/lazygit
net-im/slack
net-im/telegram-desktop-bin

