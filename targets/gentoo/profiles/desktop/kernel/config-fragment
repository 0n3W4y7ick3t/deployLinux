# Kernel config fragment for the PC (9800X3D / RTX 5080 / B850).
# Apply on top of a defconfig with:
#   cd /usr/src/linux
#   make defconfig
#   scripts/kconfig/merge_config.sh -m .config /path/to/config-fragment
#   make olddefconfig
# Human-readable rationale per group: see config-checklist.md.

# ---- no initramfs ----
# This box boots with no initrd, which turns three normally-optional
# symbols into hard requirements.
# DEVTMPFS_MOUNT: nothing else populates /dev before init runs.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# Microcode has to be linked in: late loading is disabled on current
# kernels, and the usual early path is an initrd we do not have.
# fam1ah = family 0x1A = Zen5. Check /proc/cpuinfo on a different CPU.
CONFIG_EXTRA_FIRMWARE="amd-ucode/microcode_amd_fam1ah.bin"
CONFIG_EXTRA_FIRMWARE_DIR="/lib/firmware"
# Root fs and its disk must be builtin, never modules: see filesystems
# below (XFS_FS/EXT4_FS=y) and BLK_DEV_NVME=y.

# ---- compressed firmware ----
# sys-kernel/linux-firmware installs almost everything zstd-compressed
# (/lib/firmware/**/*.bin.zst). Without these the kernel only looks for the
# uncompressed name, every runtime firmware request fails with -2, and the
# driver dies with no hint that the file is sitting right there. This cost a
# full day on the first install: it took out the amdgpu iGPU ("Fatal error
# during GPU init"), the RTW89 wifi and the RTL Bluetooth adapter all at once,
# and each looked like an unrelated driver bug.
# Note EXTRA_FIRMWARE above is unaffected — amd-ucode/ is one of the few dirs
# Gentoo leaves uncompressed, and it is linked in at build time regardless.
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# ---- platform ----
CONFIG_X86_AMD_PSTATE=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_HZ_1000=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
# MICROCODE_AMD stopped existing as a separate symbol; MICROCODE covers it
CONFIG_MICROCODE=y
CONFIG_SENSORS_K10TEMP=m
CONFIG_SENSORS_NCT6775=m
CONFIG_SP5100_TCO=m
CONFIG_EDAC_AMD64=m
CONFIG_I2C_PIIX4=m
CONFIG_I2C_CHARDEV=y
CONFIG_ZRAM=m
CONFIG_CRYPTO_ZSTD=y
# 6.12+ split the zram compressors into their own backend symbols
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_SWAP=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_BLK_DEV_NVME=y
CONFIG_MQ_IOSCHED_DEADLINE=y

# ---- filesystems ----
CONFIG_EXT4_FS=y
CONFIG_XFS_FS=y
CONFIG_VFAT_FS=y
# ntfs3 is banned: its rw mounts blanked Windows C:'s $LogFile and cost an
# UNMOUNTABLE_BOOT_VOLUME 0xED repair (2026-08). NTFS is ntfs-3g/FUSE-only
# (fstab + modprobe.d agree); the explicit not-set line keeps it that way
# even if a defconfig ever flips the default. build.sh asserts it.
# CONFIG_NTFS3_FS is not set
CONFIG_EXFAT_FS=m
CONFIG_BTRFS_FS=m
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=m
CONFIG_ISO9660_FS=m
CONFIG_NFS_FS=m
CONFIG_NFS_V4=m
CONFIG_CIFS=m
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# ---- nvidia prerequisites ----
CONFIG_MTRR=y
CONFIG_SYSVIPC=y
# the one hard requirement of nvidia-uvm
CONFIG_MMU_NOTIFIER=y
# CUDA unified memory (HMM). Not required to build the modules, but
# ZONE_DEVICE is unreachable without MEMORY_HOTPLUG, so it must come too.
# HMM_MIRROR is deliberately absent: it has no prompt and is only ever
# select-ed by a driver (nouveau, amdxdna), so a fragment cannot set it.
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y
CONFIG_ZONE_DEVICE=y
CONFIG_DEVICE_PRIVATE=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
# The 9800X3D's integrated Radeon. Drives the board's display outputs and
# is the fallback if the 5080 misbehaves. It also selects DRM_TTM_HELPER,
# which nvidia-drivers requires on 6.11+ whenever FBDEV_EMULATION is set
# and which cannot be set directly — so this replaces the DRM_QXL stub
# that used to be here purely for that.
# Consequence: two DRM cards. rice's shell/profile pins hyprland to the 5080
# by resolving the 5080's /dev/dri/by-path node to the real cardN at login
# and exporting AQ_DRM_DEVICES. Do NOT put the by-path name in that variable
# directly (it is a colon-separated list and the name contains colons), and
# do not hardcode cardN (not stable across boots).
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
# CONFIG_DRM_NOUVEAU must NOT be set (conflicts with nvidia-drivers)
# CONFIG_MODULE_SIG_FORCE must NOT be set (nvidia modules are unsigned)

# ---- kvm / vfio ----
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=m
CONFIG_KVM_AMD=m
CONFIG_VHOST_NET=m
CONFIG_VHOST_VSOCK=m
CONFIG_IOMMU_SUPPORT=y
CONFIG_AMD_IOMMU=y
CONFIG_IOMMUFD=y
CONFIG_VFIO=m
CONFIG_VFIO_PCI=m
CONFIG_TUN=m
CONFIG_BRIDGE=m
CONFIG_VETH=m
CONFIG_MACVLAN=m
CONFIG_MACVTAP=m
CONFIG_VLAN_8021Q=m
CONFIG_DUMMY=m
CONFIG_HUGETLBFS=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# ---- containers ----
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUP_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_BPF=y
CONFIG_PSI=y
CONFIG_POSIX_MQUEUE=y
CONFIG_KEYS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_FANOTIFY=y
CONFIG_CHECKPOINT_RESTORE=y

# ---- netfilter / networking ----
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NF_TABLES=m
CONFIG_NFT_COMPAT=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_MARK=m
CONFIG_NETFILTER_XT_MATCH_STATISTIC=m
# xt_nat: the DNAT/SNAT *targets*. NF_NAT is only the engine and NFT_NAT only
# the native nft expression — neither gives nft_compat something to bind
# `-j DNAT` to. Without this every published container port fails at start with
#   iptables -t nat -A DOCKER ... -j DNAT --to-destination 172.17.0.2:3306
#   Warning: Extension DNAT revision 0 not supported, missing kernel module?
# and `docker start` then leaves the container running with NO ports and NO
# network at all, which reads like a broken image rather than a kernel gap.
# MASQUERADE below is the same story for the hairpin/egress direction.
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_TARGET_REDIRECT=m
# This box is nftables-only: net-firewall/iptables[nftables] provides
# xtables-nft-multi, and `eselect iptables set xtables-nft-multi` points the
# iptables/ip6tables commands at it, so docker and libvirt still speak
# "iptables" while the kernel only ever sees nf_tables.
#
# The CONFIG_IP_NF_* / CONFIG_IP6_NF_* legacy tables that used to be listed
# here are gone deliberately. They are NOT sufficient on their own: since
# 6.15 the legacy xtables core sits behind CONFIG_NETFILTER_XTABLES_LEGACY,
# and without it ip_tables.ko is never built no matter how many IP_NF_*
# symbols are set. That is exactly how docker failed on the first install —
# "modprobe: FATAL: Module ip_tables not found" while .config claimed
# CONFIG_IP_NF_IPTABLES=m. If legacy tables are ever genuinely needed, add
# CONFIG_NETFILTER_XTABLES_LEGACY=y *and* the IP_NF_* symbols back together.
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_BRIDGE=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_CT=m
CONFIG_NF_NAT_MASQUERADE=y
# nft_chain_nat: the `type nat` chain itself. NFT_MASQ is only the expression,
# so without this libvirt's default network fails to start with
# "Failed to apply firewall command 'nft add chain ip libvirt_network guest_nat
# { type nat hook postrouting ... }': No such file or directory".
CONFIG_NFT_NAT=m
# The full set of nft statements libvirt's network driver emits is
# accept/counter/return/reject/masquerade/snat (strings on
# libvirt_driver_network.so). accept/counter/return are nf_tables core,
# masquerade is NFT_MASQ, snat is NFT_NAT — reject needs its own symbol.
CONFIG_NFT_REJECT=m
# BRIDGE_NETFILTER (docker's bridge networking) is gated behind
# NETFILTER_ADVANCED; without it olddefconfig drops the line silently.
CONFIG_NETFILTER_ADVANCED=y
CONFIG_BRIDGE_NETFILTER=m
CONFIG_IP_VS=m
CONFIG_IP_VS_RR=m
CONFIG_IP_VS_WRR=m
CONFIG_IP_VS_SH=m
CONFIG_IP_SET=m
CONFIG_NET_SCHED=y
# libvirt's whole tc path, needed before `virsh net-start default` works. It
# puts a root htb qdisc on virbr0 for every network even with no <bandwidth>,
# then adds a u32 filter with `action csum` to fix DHCP checksums for virtio.
# Each missing symbol only shows up as a net-start failure several layers from
# where it was configured, so enable the set, not one at a time:
#   htb/sfq/ingress  qdiscs      u32/fw  classifiers
#   csum             DHCP fixup  police/gact/mirred  QoS actions
CONFIG_NET_SCH_HTB=m
CONFIG_NET_SCH_SFQ=m
CONFIG_NET_CLS_U32=m
CONFIG_NET_CLS_FW=m
CONFIG_NET_ACT_CSUM=m
CONFIG_NET_ACT_POLICE=m
CONFIG_NET_ACT_GACT=m
CONFIG_NET_ACT_MIRRED=m
CONFIG_NET_SCH_INGRESS=m
CONFIG_NET_CLS_BPF=m
CONFIG_NET_SCH_FQ=y
CONFIG_TCP_CONG_BBR=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y

# ---- board (B850 / RTL8125 / 8922AE) ----
CONFIG_R8169=m
CONFIG_RTW89=m
CONFIG_RTW89_8922AE=m
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_RTL=m
CONFIG_USB4=m
CONFIG_USB_UAS=y
CONFIG_USB_XHCI_HCD=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
# keyd creates a virtual keyboard to remap caps<->esc; without uinput there is
# no /dev/uinput and the service just reports "crashed" at boot.
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_TYPEC=m
CONFIG_TYPEC_UCSI=m
CONFIG_UCSI_ACPI=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_USB_AUDIO=m

# Tux at boot, one penguin per CPU
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y

# ---- misc ----
CONFIG_WIREGUARD=m
CONFIG_PACKET=y
CONFIG_USB_MON=m
CONFIG_CRC32C_INTEL=y
CONFIG_CRYPTO_CRC32C=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
