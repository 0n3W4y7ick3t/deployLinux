# Shared make.conf fragment. One Gentoo machine today (the laptop runs
# Arch), but the shared/head split stays for the next one.
# Assembly: this file FIRST, then the machine head (make.conf.head),
# so heads can append to FEATURES/USE.

# COMMON_FLAGS/CFLAGS live in each profile's make.conf.head.
CHOST="x86_64-pc-linux-gnu"

ACCEPT_KEYWORDS="~amd64"
ACCEPT_LICENSE="*"

USE="wayland X elogind dbus udev pipewire pulseaudio screencast bluetooth vulkan opengl egl vaapi libinput zsh-completion zstd lz4 truetype harfbuzz fontconfig jpeg png webp -systemd -cups -nls"

INPUT_DEVICES="libinput"
L10N="en zh ja"

# CPU_FLAGS_X86 live in each profile's package.use/00cpu-flags, generated
# by cpuid2cpuflags on that machine.

# --jobs overlaps the serial ./configure phases that dominate the small
# -package tail; --load-average is what keeps that from oversubscribing.
# Each machine's own -l lives in MAKEOPTS in its make.conf.head.
EMERGE_DEFAULT_OPTS="--jobs=4 --load-average=16"
FEATURES="parallel-fetch parallel-install candy"

LC_MESSAGES=C
